# Copia este archivo como .env y rellena los valores. Nunca subas .env al repositorio.

# Base de datos
POSTGRES_DB=jobpilot
POSTGRES_USER=
POSTGRES_PASSWORD=
DB_URL=jdbc:postgresql://localhost:5432/jobpilot

# Seguridad
# Mínimo 32 caracteres aleatorios
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:5173

# IA
# fake | real
LLM_MODE=fake
ANTHROPIC_API_KEY=
# Vacío = claude-sonnet-5-5
ANTHROPIC_MODEL=

# Frontend
VITE_API_BASE_URL=http://localhost:8080/api/v1
