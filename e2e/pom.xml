<?xml version="1.0" encoding="UTF-8"?>
<!--
  Tests E2E de JobPilot (JP-QA-01) con Playwright for Java y JUnit. Se ejecutan contra un stack ya levantado:
    levantar docker-compose.e2e.yml (comando completo en el readme, 1.4) y después: cd e2e; ./mvnw test
  Opciones (propiedad -D o variable de entorno): frontendUrl / FRONTEND_URL (http://localhost:5173),
  headless / E2E_HEADLESS (true) y slowMo / E2E_SLOW_MO (0, en ms). Navegador visible y lento: -Dheadless=false -DslowMo=600
  La primera ejecución descarga Chromium en la caché de Playwright. En la CI se instala antes con sus dependencias
  del sistema con el plugin exec (ver .github/workflows/ci.yml y el readme, 2.6).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.jobpilot</groupId>
    <artifactId>jobpilot-e2e</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>jobpilot-e2e</name>
    <description>Tests E2E del flujo principal de JobPilot con Playwright for Java</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <playwright.version>1.64.0</playwright.version>
        <junit.version>6.0.3</junit.version>
        <surefire.version>3.5.6</surefire.version>
        <exec-plugin.version>3.7.0</exec-plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${playwright.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire.version}</version>
                <configuration>
                    <includes>
                        <include>**/*E2ETest.java</include>
                    </includes>
                    <!-- Los tests comparten el stack (y el usuario del seed): uno detrás de otro. -->
                    <forkCount>1</forkCount>
                    <reuseForks>true</reuseForks>
                </configuration>
            </plugin>
            <!-- Solo para instalar los navegadores con el CLI de Playwright (ver la CI). -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec-plugin.version}</version>
                <configuration>
                    <mainClass>com.microsoft.playwright.CLI</mainClass>
                    <classpathScope>test</classpathScope>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
